# URL do frontend (usado no CORS)
FRONTEND_URL=http://localhost:3000

# Supabase — INSTÂNCIA PRÓPRIA (NÃO o nativo do Lovable)
# anon key: expõe no frontend se ele for falar direto com o Supabase
# service_role: SÓ no backend (nunca no frontend/git)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Redis (Upstash) — cache de leitura + rate limit
REDIS_URL=https://SEU-UPSTASH.upstash.io
REDIS_TOKEN=seu_upstash_token

# Mercado Livre API (search público não exige key)
ML_APP_ID=
ML_APP_SECRET=
